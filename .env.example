# ================================
# ProductAI Studio - Environment Variables
# ================================
# Copy this file to .env.production and fill in the values

# ================================
# Server Configuration
# ================================
NODE_ENV=production
PORT=3000

# Session secret (CHANGE THIS! Use a long random string)
# Generate with: openssl rand -base64 32
SESSION_SECRET=your-super-secret-session-key-change-me

# Allowed origins (comma-separated for CORS)
ALLOWED_ORIGINS=https://yourdomain.com

# ================================
# API Keys (Server-side only, never exposed to client)
# ================================

# Primary Gemini API Key
GEMINI_API_KEY_1=your-gemini-api-key-1

# Secondary Gemini API Key (optional, for redundancy)
GEMINI_API_KEY_2=your-gemini-api-key-2

# Custom/Local API (optional)
CUSTOM_API_URL=http://127.0.0.1:8045/v1
CUSTOM_API_KEY=

# Super Resolution API (optional)
UPSCALE_API_URL=http://127.0.0.1:8045/upscale

# ================================
# Default Admin Account
# ================================
# Only used on first database initialization
DEFAULT_ADMIN_PASSWORD=change-me-immediately

# ================================
# Optional: Logging & Monitoring
# ================================
# LOG_LEVEL=info
# SENTRY_DSN=
